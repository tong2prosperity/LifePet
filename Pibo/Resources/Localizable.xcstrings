    "onboarding.partnership.boundary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pibo can only use records you allow. It cannot read your emotions, motives, or real-life experiences. You can revoke permissions, and you decide how formed `bo` is used."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pibo 只能使用你允许的记录，不能读取你的情绪、动机和现实经历。权限可以撤回，形成的 `bo` 由你决定如何使用。"
          }
        }
      }
    },
