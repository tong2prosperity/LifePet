    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pibo reads your steps, workouts, heart rate, and sleep to show activity state, record changes, and support your shared journey."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pibo 读取你的步数、运动、心率与睡眠数据，用于呈现活动状态、记录变化并推进共同旅程。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pibo 不会修改你已有的健康数据；只有在 Apple Watch 上完成心肺耦合呼吸训练后，才把这次训练作为一条体能训练记录写入健康 App。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pibo 使用大致位置获取当地天气；只有你主动开始 Walk Doodle 时，才使用精确位置绘制步行路线。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description (Debug inventory only)",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pibo 的开发版呼气互动会使用麦克风感知声音强度。"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description (Debug inventory only)",
